# Copy this file to .env.local for local work. On Netlify, add the same names under
# Site configuration -> Environment variables. Never commit real values.

# TiDB Cloud (or any MySQL): use the connection details from the "Connect" dialog.
DB_HOST=gateway01.xxxxxxxx.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=xxxxxxxx.root
DB_PASSWORD=your-db-password
DB_NAME=urban_clippers
# true for TiDB Cloud / managed databases, false for a local MySQL without TLS
DB_SSL=true

# Signs login cookies. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-64-hex-characters

# Protects POST /api/cron/reset-demo (the nightly demo reset). Use a different random value.
CRON_SECRET=replace-with-another-long-random-string

# Public site settings (optional)
NEXT_PUBLIC_SITE_URL=https://urban-clippers.netlify.app
# Set to "false" to hide the small "portfolio demo" notice near the booking form and in the footer
NEXT_PUBLIC_DEMO_NOTICE=true
# Optional: create a real admin login on top of the demo admin (used by npm run db:setup)
ADMIN_EMAIL=
ADMIN_PASSWORD=
